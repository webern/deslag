# rust canonical
target/

# common places to put ignored artifacts
build/
.build/
test/output/
.test/
.ignored/
.tmp/

# the corpus's big tier, fetched, and crane, which fetches it; see scripts/blobstore/blobs.md
.blobs/
.tools/

# the working files of deslag-gold, which makes the deslag gold set; see tools/exam
.gold/

# the working files of `deslag-gold sample --for-labelling`, the draw that training labels
.pool/

# the UD English Web Treebank that make fetch-ewt downloads, and the scratch directory it builds
# it in; see scripts/ewt/ewt.lock
.ewt/
.ewt.new.*/

# the spaCy venv and output that make fetch-spacy and generate-spacy write; see scripts/spacy/run.sh
.spacy/

# the perceptron's weights, import files and saved runs that make generate-percept writes; they derive
# from the treebank and are never committed; see scripts/train/run.sh
.train/

# Harper's tagger model that make fetch-harper downloads, for measuring only and never shipped; see
# scripts/harper/harper.lock
.harper/

# the downloads and working files of scripts/lexicon/generate.sh, which is run by hand; see
# scripts/lexicon/lexicon.lock
.lexicon/

# because llms love python
__pycache__/

# some ide stuff and other things that have appeared in the past
.idea/
.vscode/
cmake-build-*/
.obsidian/
.playwright-cli/*

# claude code local settings
.claude/settings.local.json
.claude/worktrees
CLAUDE.local.md

# just in case
*.pem
*.env
*.secrets
