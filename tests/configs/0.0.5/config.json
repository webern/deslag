{
  "cpp": {
    "allow": [
      {
        "lint": "not_at_all",
        "path": "src/a.c",
        "quote": "It does not parse at all.",
        "reason": "A frozen config sets every setting."
      }
    ],
    "exclude": [],
    "globs": [
      "/src/**/*.c",
      "/include/**/*.h"
    ],
    "lints": {
      "not_at_all": {},
      "verbs_nothing": {
        "message": "{path} hides the noun"
      }
    },
    "overrides": [
      {
        "exclude": [],
        "globs": [
          "/vendor/**"
        ]
      }
    ],
    "surfaces": [
      "doc_comment"
    ]
  },
  "deslag_version": "0.0.5",
  "md": {
    "allow": [
      {
        "lint": "not_at_all",
        "path": "docs/note.md",
        "quote": "It does not parse at all.",
        "reason": "A frozen config sets every setting."
      }
    ],
    "exclude": [],
    "fences": {
      "languages": [
        "rust"
      ],
      "surfaces": [
        "comment"
      ]
    },
    "globs": [
      "docs/*.md"
    ],
    "lints": {
      "banned_chars": {
        "allow": [
          "é"
        ],
        "ban": {
          "¤": "write the currency's name"
        },
        "groups": {
          "arrows": true,
          "box_drawing": true,
          "bullets": true,
          "checks": true,
          "dashes": true,
          "ellipsis": true,
          "emoji": false,
          "invisible": true,
          "math": true,
          "quotes": true,
          "section": true,
          "spaces": true
        },
        "message": "{path} has a banned character"
      },
      "banned_phrases": {
        "allow": [
          "not silently ignored"
        ],
        "ban": {
          "byte-identical": "say \"identical\", or name the check that shows it",
          "deliberately not": "say what it does; what it does not do rarely needs saying",
          "in order to": "write to",
          "it lands": "say what happens, such as \"it is merged\" or \"it ships\"",
          "lands on": "say what happens, such as \"is merged into\" or \"reaches\"",
          "load-bearing": "say what depends on it",
          "never silently": "say what it does instead, such as the error it reports",
          "not silently": "say what it does instead, such as the error it reports"
        },
        "message": "{path} has a banned phrase"
      },
      "density": {
        "max_item_chars": 300,
        "max_paragraph_chars": 600,
        "message": "{path} has a dense block"
      },
      "max_emphasis": {
        "free_spans": 2,
        "max_percent": 1.5,
        "message": "{path} has too much emphasis"
      },
      "max_size_bytes": {
        "message": "{path} is over {max_size_bytes} bytes",
        "value": 20000
      },
      "not_at_all": {
        "message": "{path} pads a negation"
      },
      "repo_layout": {
        "heading": "Layout",
        "max_entries": 15,
        "max_width": 100,
        "message": "{path} needs a layout",
        "min_entries": 1
      },
      "verbs_no_nouns": {
        "message": "{path} negates an object"
      },
      "verbs_nothing": {
        "message": "{path} hides the noun"
      }
    },
    "overrides": [
      {
        "exclude": [],
        "globs": [
          "docs/note.md"
        ],
        "lints": {
          "banned_phrases": {},
          "max_size_bytes": {
            "value": 8000
          }
        }
      }
    ]
  },
  "rust": {
    "allow": [
      {
        "lint": "not_at_all",
        "path": "src/lib.rs",
        "quote": "It does not parse at all.",
        "reason": "A frozen config sets every setting."
      }
    ],
    "exclude": [],
    "globs": [
      "/src/**/*.rs"
    ],
    "lints": {
      "not_at_all": {},
      "verbs_nothing": {
        "message": "{path} hides the noun"
      }
    },
    "overrides": [
      {
        "exclude": [],
        "globs": [
          "/src/tag/**"
        ]
      }
    ],
    "surfaces": [
      "doc_comment"
    ]
  },
  "schema_version": 2,
  "toml": {
    "allow": [
      {
        "lint": "not_at_all",
        "path": "Cargo.toml",
        "quote": "It does not parse at all.",
        "reason": "A frozen config sets every setting."
      }
    ],
    "exclude": [],
    "globs": [
      "/Cargo.toml",
      "/crates/**/Cargo.toml"
    ],
    "lints": {
      "not_at_all": {},
      "verbs_nothing": {
        "message": "{path} hides the noun"
      }
    },
    "overrides": [
      {
        "exclude": [],
        "globs": [
          "/tools/**"
        ]
      }
    ],
    "surfaces": [
      "comment"
    ]
  }
}
